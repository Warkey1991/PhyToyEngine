# Copy to keystore.properties, fill privately, then chmod 600 keystore.properties.
# Read as literal data by package.gradle.kts and tools/package_android_release.py, never shell-sourced.
# Passwords are literal values; do not surround them with quotes.
storeFile=/absolute/path/to/release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
