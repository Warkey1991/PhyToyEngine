{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phytoy.example/schemas/host-camera-profile-v1.json",
  "title": "PhyToyEngine HostCameraProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "version", "input", "normalization"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "host"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "color_space"],
      "properties": {
        "mode": {"enum": ["srgb", "yuv420", "raw"]},
        "color_space": {"type": "string", "minLength": 1}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb_residual_matrix"],
      "properties": {
        "rgb_residual_matrix": {"$ref": "#/$defs/matrix3"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_model": {"type": "string"},
        "camera_id": {"type": "string"},
        "source": {"type": "string"},
        "capture_date": {"type": "string"},
        "calibration_status": {"type": "string"},
        "reference_illuminant": {"type": "string"},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cfa", "black_level", "white_level", "white_balance",
        "camera_to_xyz_d65", "radiometric_scale"
      ],
      "properties": {
        "cfa": {"enum": ["RGGB", "BGGR", "GRBG", "GBRG"]},
        "black_level": {
          "oneOf": [
            {"$ref": "#/$defs/vector1"},
            {"$ref": "#/$defs/vector4"}
          ]
        },
        "white_level": {"type": "number", "exclusiveMinimum": 0},
        "white_balance": {"$ref": "#/$defs/vector3"},
        "camera_to_xyz_d65": {"$ref": "#/$defs/matrix3"},
        "radiometric_scale": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"input": {"properties": {"mode": {"const": "raw"}}}}},
      "then": {"required": ["raw"]},
      "else": {"not": {"required": ["raw"]}}
    }
  ],
  "$defs": {
    "number": {"type": "number"},
    "vector1": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/number"}
    },
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/number"}
    },
    "vector4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/number"}
    },
    "matrix3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/vector3"}
    }
  }
}
